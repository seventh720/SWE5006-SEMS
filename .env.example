POSTGRES_DB=sems
POSTGRES_USER=sems_user
POSTGRES_PASSWORD=replace-with-a-local-password
DB_URL=jdbc:postgresql://localhost:5432/sems
DB_USERNAME=sems_user
DB_PASSWORD=replace-with-a-local-password

# At least 32 characters. Generate a different value for every deployed environment.
SEMS_JWT_SECRET=replace-with-at-least-32-random-characters
SEMS_JWT_ISSUER=sems-api
SEMS_JWT_TTL=PT30M

# Optional. Leave blank if an administrator should not be created at startup.
SEMS_BOOTSTRAP_ADMIN_USERNAME=admin
SEMS_BOOTSTRAP_ADMIN_EMAIL=
SEMS_BOOTSTRAP_ADMIN_PASSWORD=

VITE_API_URL=
